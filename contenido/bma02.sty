% Preguntas metacognitivas comunes a todas las sesiones
\newcommand{\metacomun}{%
  \item ¿Qué idea de hoy puedo explicar con mis palabras sin mirar mis notas? ¿Cuál no?
  \item ¿Cómo cambió mi forma de resolver respecto de lo que hice en la tarea previa?}
% Criterios comunes de las prácticas
\newcommand{\criterios}{%
  \textbf{Criterios (rúbrica común):} (1) corrección y rigor matemático; (2) justificación y notación;
  (3) modelamiento e interpretación del resultado; (4) comunicación y trazabilidad, incluida la declaración de uso de IA.}
% Declaración de uso de IA
\newcommand{\declaracionia}{%
  \textbf{Declaración de uso de IA:} indique qué herramienta usó, para qué, qué verificó por su cuenta y qué corrigió.
  El estudiante responde por la calidad y sustentación de lo que entrega.}

